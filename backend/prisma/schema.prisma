// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum SlotStatus {
  AVAILABLE
  SOLD_OUT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum PaymentProvider {
  OPN
}

enum KioskSessionType {
  RESTOCK_AUTH
  FACE_REGISTRATION
  EMPLOYEE_DRAFT_DELETE
  EMPLOYEE_OFFBOARDING
}

enum KioskSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model Product {
  id           Int           @id @default(autoincrement())
  name         String
  price        Decimal       @db.Decimal(10, 2)
  imageUrl     String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  slots        Slot[]
  transactions Transaction[]
}

model Slot {
  id           Int           @id @default(autoincrement())
  slotNumber   Int           @unique
  status       SlotStatus    @default(AVAILABLE)
  productId    Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  product      Product?      @relation(fields: [productId], references: [id])
  transactions Transaction[]

  @@index([productId])
}

model Transaction {
  id                          Int             @id @default(autoincrement())
  slotId                      Int
  productId                   Int
  amount                      Decimal         @db.Decimal(10, 2)
  paymentStatus               PaymentStatus   @default(PENDING)
  paymentProvider             PaymentProvider
  providerChargeId            String?         @unique
  providerStatus              String?
  expiresAt                   DateTime?
  paidAt                      DateTime?
  saleNotificationAttemptedAt DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  slot                        Slot            @relation(fields: [slotId], references: [id])
  product                     Product         @relation(fields: [productId], references: [id])

  @@index([slotId])
  @@index([productId])
}

model Employee {
  id             Int            @id @default(autoincrement())
  name           String
  employeeCode   String         @unique
  faceEmbedding  Json?
  faceRegistered Boolean        @default(false)
  isActive       Boolean        @default(true)
  offboardedAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  restockLogs    RestockLog[]
  kioskSessions  KioskSession[]
}

model KioskSession {
  id          Int                @id @default(autoincrement())
  machineId   String
  type        KioskSessionType
  status      KioskSessionStatus @default(ACTIVE)
  employeeId  Int?
  createdAt   DateTime           @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  employee    Employee?          @relation(fields: [employeeId], references: [id])

  @@index([machineId, status, expiresAt])
  @@index([employeeId])
}

model RestockLog {
  id                      Int       @id @default(autoincrement())
  employeeId              Int
  note                    String?
  beforeStatus            Json?
  afterStatus             Json?
  notificationAttemptedAt DateTime?
  createdAt               DateTime  @default(now())
  employee                Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

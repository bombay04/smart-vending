PORT=3000
DATABASE_URL="postgresql://postgres:postgres123@localhost:5435/smart_vending"
# Comma-separated allowlist of exact frontend origins (scheme, host, and port).
# Keep localhost for development. When /staff is opened through the Pi LAN
# address, also add that exact origin, for example: http://<PI_IP>:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
OMISE_SECRET_KEY=skey_test_replace_me
OMISE_API_VERSION=2019-05-29
OMISE_PROMPTPAY_EXPIRY_MINUTES=15
# Base64-encoded secret from the Opn/Omise webhook settings. Optional locally
# because webhook payloads are never trusted and charge state is re-fetched.
OMISE_WEBHOOK_SECRET=

# LINE Messaging API push configuration. Keep both values server-side.
LINE_CHANNEL_ACCESS_TOKEN=replace_with_line_channel_access_token
LINE_TARGET_ID=replace_with_line_user_or_group_id

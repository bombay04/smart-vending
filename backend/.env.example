PORT=3000
DATABASE_URL="postgresql://postgres:postgres123@localhost:5435/smart_vending"
# Comma-separated allowlist of exact frontend origins (scheme, host, and port).
# Keep localhost for development. When /staff is opened through the Pi LAN
# address, also add that exact origin, for example: http://<PI_IP>:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Non-secret identifier used to scope the single pilot kiosk session.
KIOSK_MACHINE_ID=PILOT_KIOSK
# Dedicated machine hostname. Requests for this exact Host are JWT-verified and
# restricted to the Pi method/path allowlist before reaching API routes.
PI_API_HOSTNAME=pi-api.smartvendingpt.com
# Cloudflare Access team origin, dedicated Pi application AUD tag, and the
# non-secret Client ID/common_name of the one allowed Pi service token.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://replace-with-team-name.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace_with_pi_access_application_aud
CLOUDFLARE_ACCESS_SERVICE_TOKEN_CLIENT_ID=replace_with_pi_service_token_client_id
OMISE_SECRET_KEY=skey_test_replace_me
OMISE_API_VERSION=2019-05-29
# PromptPay QR charges use the application's fixed three-minute expiry.
# Base64-encoded secret from the Opn/Omise webhook settings. Optional locally
# because webhook payloads are never trusted and charge state is re-fetched.
OMISE_WEBHOOK_SECRET=

# LINE Messaging API broadcast configuration. Keep this value server-side.
LINE_CHANNEL_ACCESS_TOKEN=replace_with_line_channel_access_token
# Dedicated SmartVendingOwner token. Never reuse the employee OA token above.
LINE_OWNER_CHANNEL_ACCESS_TOKEN=replace_with_owner_line_channel_access_token
# Local/manual safety gate only. Do not set this on production Cron services.
OWNER_REPORT_DEMO_ENABLED=false

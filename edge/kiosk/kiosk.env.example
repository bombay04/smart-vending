# The frontend may be local or hosted. Keep localhost when Chromium and Vite run on the Pi.
KIOSK_URL=http://localhost:5173

# Optional override for unusual Chromium installations.
# CHROMIUM_BIN=/usr/bin/chromium

# Seconds between URL readiness checks. Must be a positive whole number.
KIOSK_READY_RETRY_SECONDS=2

# At most 30 checks, requiring two consecutive successes (minimum 2).
# A local Vite URL also checks /src/main.tsx. Failure exits without opening Chromium.
KIOSK_READY_MAX_ATTEMPTS=30

# Copy this file to:
# /home/user/.config/smart-vending/pi-unlock-service.env
#
# This file is read directly by systemd. Use KEY=value entries, not shell
# commands such as export or source. Keep the installed copy private and add
# future machine-specific settings there rather than editing the service unit.

ESP32_SERIAL_PORT=/dev/ttyUSB0
AUDIO_ALSA_DEVICE=plughw:CARD=UACDemoV10,DEV=0
FACE_CAMERA_INDEX=0
FACE_CAMERA_USB_RECOVERY_ENABLED=true
FACE_CAMERA_USB_RECOVERY_HELPER=/usr/local/sbin/smart-vending-camera-reset
FACE_CAMERA_USB_RECOVERY_TIMEOUT_SECONDS=20
FACE_CAMERA_USB_RECOVERY_COOLDOWN_SECONDS=60

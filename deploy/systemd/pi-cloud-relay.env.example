# Install as /etc/smart-vending/pi-cloud-relay.env, owned by root:root and mode 0600.
# Never commit the installed file or copy its values into frontend/Vite variables.

PI_CLOUD_UPSTREAM_ORIGIN=https://pi-api.smartvendingpt.com
PI_CLOUD_RELAY_HOST=127.0.0.1
PI_CLOUD_RELAY_PORT=3000
PI_CLOUD_CONNECT_TIMEOUT_SECONDS=5
PI_CLOUD_READ_TIMEOUT_SECONDS=30
KIOSK_MACHINE_ID=PILOT_KIOSK
HARDWARE_HEARTBEAT_INTERVAL_SECONDS=30

# Replace both placeholders only in the installed root-owned file.
# These become the CF-Access-Client-Id and CF-Access-Client-Secret request headers.
CF_ACCESS_CLIENT_ID=replace_with_pi_service_token_client_id
CF_ACCESS_CLIENT_SECRET=replace_with_pi_service_token_client_secret
